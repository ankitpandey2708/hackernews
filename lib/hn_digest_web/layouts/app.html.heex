<%= if msg = Phoenix.Flash.get(@flash, :info) do %>
  <p
    class="fixed top-4 right-4 z-50 px-4 py-3 rounded-lg font-mono text-sm bg-accent/10 text-accent border border-accent/20"
    role="alert"
    phx-click="lv:clear-flash"
    phx-value-key="info"
  >
    <%= msg %>
  </p>
<% end %>

<%= if msg = Phoenix.Flash.get(@flash, :error) do %>
  <p
    class="fixed top-4 right-4 z-50 px-4 py-3 rounded-lg font-mono text-sm bg-destructive/10 text-destructive border border-destructive/20"
    role="alert"
    phx-click="lv:clear-flash"
    phx-value-key="error"
  >
    <%= msg %>
  </p>
<% end %>

<%= @inner_content %>
